APP_NAME="Dot.docs"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=infodot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# The shared Dot.Files blob store. Point every product in the ecosystem at the
# SAME directory: a `files.path` row written by any of them has to resolve to
# the same bytes. Private — nothing here is reachable by URL, only through the
# signed /files/{uuid}/view route. See .ai/rules/files.md.
# FILES_ROOT is left unset on purpose: env() returns '' for an empty value, not
# null, so writing `FILES_ROOT=` would make the disk root the empty string
# rather than the storage_path('app/files') default.
FILES_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="no-reply@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=infodot
REVERB_APP_KEY=infodot-key
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Ecosystem SSO — hub URL for cross-platform token issuance
INFODOT_URL=https://infodot.app

# While someone is signed in, ask InfoDot whether their current company still holds Dot.docs (answer cached 10
# minutes per company; any failure lets the person carry on). Set false to switch the check off.
DOCS_ENTITLEMENT_CHECK=true

# AI (Dot.docs) — 'mock' is the safe default: no provider is contacted at all.
# Set AI_PROVIDER=live once a key below is present. See config/ai.php.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_DRAFT=claude-sonnet-5
AI_MODEL_COMPOSE=claude-opus-5
AI_MODEL_QUICK=claude-haiku-4-5-20251001

# Co-editing metrics (counts only, see config/docs.php and php artisan sync:report).
DOCS_SYNC_METRICS=true

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false

# Strict-Transport-Security max-age in seconds, sent on HTTPS responses only (see config/security.php). 0 turns it off.
SECURITY_HSTS_SECONDS=15552000
# R2-1: the Content-Security-Policy is enforced; false sends it report-only (the switch if a page breaks).
SECURITY_CSP_ENFORCE=true
# R2-1: API tokens expire after this many minutes (90 days).
SANCTUM_TOKEN_EXPIRATION=129600
# R2-2: errors the app reports are mailed here (once per distinct error an hour, at most 10 an hour). Empty: off.
OPS_ALERT_EMAIL=

# Encrypts the nightly database + uploads backups (EA-6). Long random value; keep a copy in a password manager.
BACKUP_PASSPHRASE=
BACKUP_KEEP=14
